@model IEnumerable<Obligatorio.DTOs.DTOsUsuario.DTOUsuario>

@{
    ViewData["Title"] = "List";
}

<h1>Usuarios que realizaron pagos mayores a:</h1>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div>
                <label> Ingrese el monto total a comparar:</label>
                <Input type="number" name="montoFiltro" class="form-control" />
            </div>

            <div class="form-group">
                <button type="submit">Buscar</button>
            </div>
        </form>
    </div>
</div>
<p>
    <a asp-action="Create">Create New</a>
</p>

@if (Model is not null && Model.Count() > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Apellido)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Email)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Rol)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Equipo)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Apellido)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Rol)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Equipo)
                </td>
            </tr>
    }
        </tbody>
    </table>
}
else
{
    <p> @ViewBag.Mensaje </p>
}
