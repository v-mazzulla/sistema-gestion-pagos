<h1>Ingerese el mail del usuario</h1>
<p>Por favor asegurese de ingresar el email correcto, esta accion no se puede deshacer</p>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div>
                <Input type="text" name="usuarioEmail" class="form-control" />
            </div>

            <div class="form-group">
                <button type="submit">Enviar</button>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.Mensaje != null)
{
    <p class="text-danger">@ViewBag.Mensaje</p>
}
@if (ViewBag.MensajeE != null)
{
    <p class="text-danger">@ViewBag.MensajeE</p>
}