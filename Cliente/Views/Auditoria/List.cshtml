@model IEnumerable<HTTPClienteObligatorio.Models.DTOAuditoria>

@{
    ViewData["Title"] = "List";
}

<h1>Id Tipo de gasto</h1>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div>
                <Input type="number" name="idBuscar" class="form-control" />
            </div>

            <div class="form-group">
                <button type="submit">Buscar</button>
            </div>
        </form>
    </div>
</div>


@if (Model is not null && Model.Count() > 0)
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
                <th>
                    Accion realizada
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Fecha)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Administrador)
                </th>
                <th>
                    Tipo de gasto
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AccionRealizada)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Fecha)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Administrador)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TipoGasto)
                </td>
            </tr>
    }
        </tbody>
    </table>
}
else
{
    <p> @ViewBag.Mensaje </p>
}
